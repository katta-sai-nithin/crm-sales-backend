# Local development environment - real values live in .env (git-ignored)

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/crm_sales_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm_sales_db?retryWrites=true&w=majority
MONGODB_URI=
MONGO_DB_NAME=
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20

# JWT secrets - MUST be replaced with long random values (>= 32 chars each, different from each other).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=crm-sales-api
JWT_AUDIENCE=crm-sales-client

BCRYPT_SALT_ROUNDS=12

# Comma separated CORS allowlist of browser front-ends.
# Same-origin requests (the API calling itself, e.g. the Swagger UI served at
# /api-docs) are always allowed and do not need to be listed here.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting (global API limiter)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Stricter limiter for credential endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

JSON_BODY_LIMIT=1mb
TRUST_PROXY=false

# Refresh token delivery: also set an HttpOnly cookie for browser clients.
REFRESH_TOKEN_IN_COOKIE=true
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Strict

# Bootstrap administrator (used by `npm run bootstrap-admin`).
# Never hardcode a production password: generate one locally and keep it out of git.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Demo seeding (`npm run seed`). Never enable in production.
SEED_DEMO_DATA=false
SEED_FORCE=false

# Background maintenance jobs (persists the derived OVERDUE activity flag).
JOBS_ENABLED=false
OVERDUE_JOB_INTERVAL_MS=3600000

LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true

DEAL_CURRENCY=USD
SHUTDOWN_TIMEOUT_MS=10000

APP_NAME=CRM Sales Management API
APP_VERSION=1.0.0