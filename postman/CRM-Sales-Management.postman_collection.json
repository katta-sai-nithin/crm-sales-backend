            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/assignment", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "assignment"] }
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] },
            "description": "Refused (422) while the customer still has deals or activities."
          }
        }
      ]
    },
    {
      "name": "Deals",
      "item": [
        {
          "name": "Create deal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Globex - Enterprise Rollout\",\n  \"customer\": \"{{customerId}}\",\n  \"dealValue\": 75000,\n  \"probability\": 70,\n  \"expectedClosingDate\": \"2027-09-30T00:00:00.000Z\",\n  \"stage\": \"DISCOVERY\",\n  \"description\": \"Multi year rollout\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/deals", "host": ["{{baseUrl}}"], "path": ["deals"] },
            "description": "expectedRevenue (52500) is computed by the server and cannot be supplied."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('dealId', json.data.id);",
                  "pm.test('expectedRevenue = 75000 x 70 / 100', () => pm.expect(json.data.expectedRevenue).to.eql(52500));"
                ]
              }
            }
          ]
        },
        {
          "name": "List deals (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/deals?stage=QUALIFICATION,DISCOVERY,PROPOSAL,NEGOTIATION&minValue=1000&maxValue=500000&sortBy=dealValue&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["deals"],
              "query": [
                { "key": "stage", "value": "QUALIFICATION,DISCOVERY,PROPOSAL,NEGOTIATION" },
                { "key": "minValue", "value": "1000" },
                { "key": "maxValue", "value": "500000" },
                { "key": "sortBy", "value": "dealValue" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get deal",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}"] }
          }
        },
        {
          "name": "Update deal",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dealValue\": 80000,\n  \"probability\": 75\n}" },
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}"] },
            "description": "expectedRevenue is recomputed to 60000. Closed deals reject updates (422)."
          }
        },
        {
          "name": "Advance deal stage",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"PROPOSAL\"\n}" },
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}/stage", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}", "stage"] }
          }
        },
        {
          "name": "Reassign deal",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assignedTo\": \"{{userId}}\",\n  \"reason\": \"Handover\"\n}" },
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}/assignment", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}", "assignment"] }
          }
        },
        {
          "name": "Mark deal as WON",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"WON\"\n}" },
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}/stage", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}", "stage"] },
            "description": "Probability is normalised to 100 and closedAt is set. A closed deal cannot go back to an active stage."
          }
        },
        {
          "name": "Reopen closed deal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"NEGOTIATION\",\n  \"reason\": \"Contract renegotiation\"\n}" },
            "url": { "raw": "{{baseUrl}}/deals/{{dealId}}/reopen", "host": ["{{baseUrl}}"], "path": ["deals", "{{dealId}}", "reopen"] },
            "description": "Explicit, separately authorised operation (ADMIN / SALES_MANAGER)."
          }
        },
