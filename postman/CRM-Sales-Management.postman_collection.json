            "url": { "raw": "{{baseUrl}}/activities", "host": ["{{baseUrl}}"], "path": ["activities"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json(); pm.collectionVariables.set('activityId', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List activities (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities?type=CALL,FOLLOW_UP&status=PENDING&sortBy=dueDate&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["activities"],
